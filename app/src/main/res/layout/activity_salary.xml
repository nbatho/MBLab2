<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/salary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".activities.SalaryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/salary_tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="Lương của tôi" />

        <TextView
            android:id="@+id/salary_tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:text="NV001 – Nguyễn Văn A"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/salary_btn_prev_month"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salary_prev_month" />

            <TextView
                android:id="@+id/salary_tv_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Tháng 10/2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/salary_btn_next_month"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salary_next_month" />
        </LinearLayout>

        <!-- Chế độ Employee: chỉ xem bảng lương của mình -->
        <LinearLayout
            android:id="@+id/salary_section_employee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salary_detail_header"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/salary_tv_no_record"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/salary_no_record"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/salary_group_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/salary_tv_detail_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            tools:text="Trạng thái: Nháp" />

                        <TextView
                            android:id="@+id/salary_tv_detail_total_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Tổng giờ làm: 18,00 giờ" />

                        <TextView
                            android:id="@+id/salary_tv_detail_regular_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Giờ thường: 16,00 giờ" />

                        <TextView
                            android:id="@+id/salary_tv_detail_overtime_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Giờ tăng ca: 2,00 giờ" />

                        <TextView
                            android:id="@+id/salary_tv_detail_rate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Đơn giá hiện tại: 50.000 đ/giờ" />

                        <TextView
                            android:id="@+id/salary_tv_detail_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            tools:text="Tổng lương: 950.000 đ" />

                        <TextView
                            android:id="@+id/salary_tv_detail_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salary_current_header"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/salary_tv_current_shifts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="Số ca hoàn tất: 2" />

                    <TextView
                        android:id="@+id/salary_tv_current_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Tổng giờ làm: 18,00 giờ" />

                    <TextView
                        android:id="@+id/salary_tv_current_overtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Giờ tăng ca: 2,00 giờ" />

                    <TextView
                        android:id="@+id/salary_tv_current_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Chế độ Admin: tính DRAFT, chốt PAID, xóa DRAFT -->
        <LinearLayout
            android:id="@+id/salary_section_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salary_admin_calculate_header"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/salary_admin_employee_hint"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />

                    <Spinner
                        android:id="@+id/salary_spinner_employee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/salary_tv_no_employees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salary_admin_no_employees"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/salary_btn_calculate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/salary_btn_calculate" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/salary_admin_list_header"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/salary_tv_list_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/salary_admin_list_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/salary_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
