<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_menu_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/main_txt_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Xin chào admin (Quản trị viên)" />

        <LinearLayout
            android:id="@+id/main_group_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/main_btn_employees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_menu_employees" />

            <Button
                android:id="@+id/main_btn_admin_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_menu_admin_salary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_group_employee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/main_btn_attendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_menu_attendance" />

            <Button
                android:id="@+id/main_btn_my_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_menu_my_salary" />
        </LinearLayout>

        <Button
            android:id="@+id/main_btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_menu_logout" />
    </LinearLayout>
</ScrollView>
